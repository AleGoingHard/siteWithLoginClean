@model IEnumerable<sitoAutenticazioneFrau.Models.Product>
@{
    ViewData["Title"] = "Prodotti";
}

<h2>Prodotti</h2>

<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text">@product.Description</p>
                    <p class="card-text"><strong>@product.Price.ToString("C")</strong></p>

                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="add-to-cart-form" data-product-id="@product.Id">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@product.Id" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" class="btn btn-primary">Aggiungi al carrello</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<script>
    $(document).ready(function() {
        $('.add-to-cart-form').submit(function(e) {
            e.preventDefault(); // Evita ricarica della pagina

            var form = $(this);
            var productId = form.data('product-id');

            $.post('/Cart/AddToCart', { productId: productId, quantity: 1 })
                .done(function() {
                    // Aggiorna il contatore carrello se esiste
                    $.get('/Cart/GetCartCount')
                        .done(function(count) {
                            $('#cart-count').text(count);
                        });
                })
                .fail(function() {
                    alert("Errore durante l'aggiunta al carrello.");
                });
        });
    });
</script>
